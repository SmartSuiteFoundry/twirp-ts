{
  "compilerOptions": {
    // es2021, not es2022: TwirpError.cause() is a method, and ES2022 adds
    // Error.cause as a property, which collides (TS2425). Renaming it would
    // break automation-core and metrics.
    "target": "es2021",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
