{
  "name": "@smartsuite-foundry/twirp-ts",
  "version": "3.0.0",
  "description": "TypeScript implementation of the Twirp protocol (SmartSuite fork)",
  "type": "module",
  "bin": {
    "protoc-gen-twirp_ts": "./protoc-gen-twirp_ts.cjs"
  },
  "files": [
    "dist",
    "protoc-gen-twirp_ts.cjs"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmartSuiteFoundry/twirp-ts.git"
  },
  "homepage": "https://github.com/SmartSuiteFoundry/twirp-ts#readme",
  "bugs": {
    "url": "https://github.com/SmartSuiteFoundry/twirp-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "tshy": {
    "exclude": [
      "src/**/__tests__/**",
      "src/**/__mocks__/**"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/twirp/index.ts",
      "./plugin": "./src/protoc-gen-twirp-ts/plugin.ts"
    }
  },
  "scripts": {
    "build": "tshy",
    "prepack": "tshy",
    "format": "prettier -w src/**/*.ts",
    "lint": "prettier -c src/**/*.ts",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:coverage": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage"
  },
  "keywords": [
    "Twirp",
    "Typescript"
  ],
  "author": "Fabrizio Fenoglio",
  "contributors": [
    "SmartSuite <https://github.com/SmartSuiteFoundry>"
  ],
  "license": "MIT",
  "dependencies": {
    "@protobuf-ts/plugin-framework": "^2.11.0",
    "camel-case": "^4.1.2",
    "dot-object": "^2.1.5",
    "path-to-regexp": "^6.2.0",
    "ts-poet": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/dot-object": "^2.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "http-terminator": "^3.2.0",
    "jest": "^30.5.1",
    "openapi-types": "^12.1.3",
    "prettier": "^2.3.2",
    "semantic-release": "^25.0.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-proto": "^1.81.3",
    "tshy": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@protobuf-ts/plugin": "^2.5.0",
    "ts-proto": "^1.81.3"
  },
  "peerDependenciesMeta": {
    "@protobuf-ts/plugin": {
      "optional": true
    },
    "ts-proto": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/twirp/index.d.ts",
        "default": "./dist/esm/twirp/index.js"
      },
      "require": {
        "types": "./dist/commonjs/twirp/index.d.ts",
        "default": "./dist/commonjs/twirp/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/esm/protoc-gen-twirp-ts/plugin.d.ts",
        "default": "./dist/esm/protoc-gen-twirp-ts/plugin.js"
      },
      "require": {
        "types": "./dist/commonjs/protoc-gen-twirp-ts/plugin.d.ts",
        "default": "./dist/commonjs/protoc-gen-twirp-ts/plugin.js"
      }
    }
  },
  "main": "./dist/commonjs/twirp/index.js",
  "types": "./dist/commonjs/twirp/index.d.ts",
  "module": "./dist/esm/twirp/index.js"
}
