{
  "name": "@smartsuite-foundry/twirp-ts",
  "version": "3.2.0",
  "description": "TypeScript implementation of the Twirp protocol (SmartSuite fork)",
  "type": "module",
  "bin": {
    "protoc-gen-twirp_ts": "protoc-gen-twirp_ts.mjs",
    "twirp-ts-esm-extensions": "esm-extensions.mjs"
  },
  "files": [
    "dist",
    "protoc-gen-twirp_ts.mjs",
    "esm-extensions.mjs"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmartSuiteFoundry/twirp-ts.git"
  },
  "homepage": "https://github.com/SmartSuiteFoundry/twirp-ts#readme",
  "bugs": {
    "url": "https://github.com/SmartSuiteFoundry/twirp-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "clean": "rm -rf dist",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "cs": "biome format --write .",
    "cs:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:coverage": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage"
  },
  "keywords": [
    "Twirp",
    "Typescript"
  ],
  "author": "Fabrizio Fenoglio",
  "contributors": [
    "SmartSuite <https://github.com/SmartSuiteFoundry>"
  ],
  "license": "MIT",
  "dependencies": {
    "@protobuf-ts/plugin-framework": "^2.11.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "camel-case": "^4.1.2",
    "dot-object": "^2.1.5",
    "path-to-regexp": "^8.4.2",
    "ts-poet": "^6.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@jest/globals": "^30.5.2",
    "@protobuf-ts/plugin": "^2.11.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/dot-object": "^2.1.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "http-terminator": "^3.2.0",
    "jest": "^30.5.2",
    "jest-mock": "^30.5.2",
    "openapi-types": "^12.1.3",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "ts-proto": "^2.18.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@protobuf-ts/plugin": "^2.5.0",
    "ts-proto": "^1.81.3 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@protobuf-ts/plugin": {
      "optional": true
    },
    "ts-proto": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/twirp/index.d.ts",
      "default": "./dist/twirp/index.js"
    },
    "./server": {
      "types": "./dist/twirp/node.d.ts",
      "default": "./dist/twirp/node.js"
    },
    "./plugin": {
      "types": "./dist/protoc-gen-twirp-ts/plugin.d.ts",
      "default": "./dist/protoc-gen-twirp-ts/plugin.js"
    },
    "./esm-extensions": {
      "types": "./dist/esm-extensions/index.d.ts",
      "default": "./dist/esm-extensions/index.js"
    }
  },
  "main": "./dist/twirp/index.js",
  "types": "./dist/twirp/index.d.ts"
}
